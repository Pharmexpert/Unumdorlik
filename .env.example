ANTHROPIC_API_KEY=         # faqat script.provider=anthropic bo'lsa. DIQQAT: claude_cli bilan birga qo'ymang — obuna o'rniga API'dan pul sarflaydi
# CLAUDE_CODE_OAUTH_TOKEN=  # faqat CI (GitHub Secrets) uchun; lokal mashinada `claude` login yetarli
UNUMDORLIK_PROFILE=stack-b # yoki stack-a; config/pipeline.yaml bo'lsa u ustun
